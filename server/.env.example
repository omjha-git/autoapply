# AutoApply Server — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.

PORT=5000

CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/AutoApply?retryWrites=true&w=majority

# Clerk authentication
# Get these from https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Gemini AI (OPTIONAL — only for cover-letter generation & optional profile
# enrichment). Resume text extraction and job matching work WITHOUT it.
# If GEMINI_API_KEY is missing/empty/quota-exhausted, the app continues to
# function: resumes are parsed locally and match scores are computed locally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Retry configuration for Gemini network requests (cover letters only).
# Retry configuration for Gemini network requests.
# Defaults: 3 retries, 2000ms base delay (with jitter).
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_DELAY_MS=2000

# OpenAI (optional — only if using OpenAI features)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Greenhouse job boards
# Comma-separated board tokens (the slug in https://boards.greenhouse.io/<token>)
# Example: stripe,airbnb,coinbase
GREENHOUSE_BOARD_TOKENS=

# Lever job boards
# Comma-separated company slugs (the path in https://jobs.lever.co/<slug>)
# To find a slug: visit jobs.lever.co/<company-name> and check if the page exists.
# Verified working example: leverdemo
# Add only slugs you have verified exist.
LEVER_SITES=leverdemo

# Per-board timeout (ms) for a single Lever board fetch. The public Lever API
# can stream large posting sets (e.g. ~310 jobs / ~6MB for palantir, ~8s) that
# axios's `timeout` does NOT abort. A per-board AbortController cancels a single
# slow board so it can't stall the whole Lever source. Must be < the aggregator's
# 15s backstop. (default: 12000)
LEVER_TIMEOUT_MS=12000

# Max parallel Lever board fetches (bounded concurrency). (default: 5)
LEVER_MAX_CONCURRENT=5

# Ashby job boards
# Comma-separated company slugs (the path in https://api.ashbyhq.com/posting-api/job-board/<slug>)
# Ashby hosts career pages for many companies (e.g. ashbyhq, retool, modal, ramp).
# Each returns a real JSON feed of individual job postings.
ASHBY_BOARDS=ashbyhq

# Wellfound (formerly AngelList Talent) companies
# Comma-separated company slugs (e.g. stripe, airbnb, coinbase).
# Wellfound is a JS-heavy SPA with no public job API. When Selenium + Chrome
# are available (see below), individual jobs are extracted via WebDriver
# element queries (primary) and regex-based HTML parsing (fallback).
# Otherwise, the adapter returns search-link cards (no scraping).
# WELLFOUND_MAX_CONCURRENT limits parallel browser launches (default: 3).
WELLFOUND_COMPANIES=stripe,airbnb,coinbase
WELLFOUND_MAX_CONCURRENT=3

# Selenium / Chrome (OPTIONAL — only for JS-rendered sources like Wellfound)
# When set to "false" or when selenium-webdriver is not installed, JS-rendered
# sources use search-link fallbacks instead.
SELENIUM_ENABLED=true
# Maximum concurrent browser launches (default: 3). Prevents resource
# exhaustion when multiple Selenium-based sources fetch pages in parallel.
SELENIUM_MAX_CONCURRENT=3
# Page-load and script timeouts for WebDriver (in ms).
SELENIUM_PAGE_LOAD_TIMEOUT_MS=15000
SELENIUM_SCRIPT_TIMEOUT_MS=10000

# Internshala & Indeed integrations
# ------------------------------------------------------------
# NEITHER source offers a public, seeker-facing listings API, and both
# actively block automated scraping (anti-bot / ToS). They therefore use
# honest search-link fallbacks: no credentials are needed or accepted,
# and real listings are surfaced by linking the user out to the public
# search page. No keys are required for these adapters.
#
# Internshala: https://internshala.com/internships?keyword=...&location=...
# Indeed:      https://www.indeed.com/jobs?q=...&l=...
#
# (The line below is intentionally empty — no FIRECRAWL/Indeed/Internshala
# credentials are supported or read by these adapters.)
# FIRECRAWL_API_KEY=
