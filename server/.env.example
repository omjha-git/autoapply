# AutoApply Server — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.

PORT=5000

CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/AutoApply?retryWrites=true&w=majority

# Clerk authentication
# Get these from https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Gemini AI (for resume extraction)
# Get this from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (optional — only if using OpenAI features)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Greenhouse job boards
# Comma-separated board tokens (the slug in https://boards.greenhouse.io/<token>)
# Example: stripe,airbnb,coinbase
GREENHOUSE_BOARD_TOKENS=

# Lever job boards
# Comma-separated company slugs (the path in https://jobs.lever.co/<slug>)
# To find a slug: visit jobs.lever.co/<company-name> and check if the page exists.
# Verified working example: leverdemo
# Add only slugs you have verified exist.
LEVER_SITES=leverdemo

# FIRECRAWL_API_KEY is NOT required.
# Internshala does not provide a public API. The Internshala adapter
# uses a search-link fallback with no API key needed.
# If Internshala releases an official API, add the key here:
# FIRECRAWL_API_KEY=
